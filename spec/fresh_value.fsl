// A value defined again after the log is a new value.
//
// SSA gives one name to a call in a loop body. Each iteration still makes a
// new error. The path walk from a log call records the blocks it enters. A
// value defined in one of them is not the value that was logged. This spec
// checks that rule against what happens at run time.
//
// The program is one loop:
//
//   for {
//     err := do()        defineError: a new error each time
//     log(err)           logError: optional, any number of times
//     return err         returnError: or loopBack to go round again
//   }
//
// currentError numbers the error that err holds. loggedErrors is every error
// that was ever logged. It is the ground truth. loggedSinceDefinition is what
// the rule looks at: a log with no definition of err between it and the
// return.
//
// ASSUME-1: MAX_ITERATIONS bounds the number of iterations. It is a modeling
// bound, not a claim about loops.
fsl 5
spec FreshValue {
  const MAX_ITERATIONS = 3
  type ErrorNumber = 0..MAX_ITERATIONS
  enum Location { Define, Body, Returned }

  state {
    location: Location,
    currentError: ErrorNumber,
    loggedErrors: Set<ErrorNumber>,
    loggedSinceDefinition: Bool,
    reported: Bool,
    returnedWasLogged: Bool
  }

  init {
    location = Define
    currentError = 0
    loggedErrors = Set {}
    loggedSinceDefinition = false
    reported = false
    returnedWasLogged = false
  }

  action defineError() {
    requires location == Define
    requires currentError < MAX_ITERATIONS
    location = Body
    currentError = currentError + 1
    loggedSinceDefinition = false
  }

  action logError() {
    requires location == Body
    loggedErrors = loggedErrors.add(currentError)
    loggedSinceDefinition = true
  }

  action loopBack() {
    requires location == Body
    location = Define
  }

  action returnError() {
    requires location == Body
    location = Returned
    reported = loggedSinceDefinition
    returnedWasLogged = loggedErrors.contains(currentError)
  }

  terminal {
    location == Returned
    or (location == Define and currentError == MAX_ITERATIONS)
  }

  // The rule never reports an error that was not logged.
  invariant NeverReportsAFreshValue { reported => returnedWasLogged }
  // In this shape the rule is also exact. Every error logged and returned is
  // reported.
  invariant ReportsEveryDouble { returnedWasLogged => reported }

  // This is the case the rule exists for. An error is logged in one
  // iteration, and a new one is returned in the next. The rule stays silent.
  reachable SilentOnTheNextIteration {
    location == Returned
    and not reported
    and loggedErrors.size() > 0
    and not loggedErrors.contains(currentError)
  }

  // --- auxiliary ---
  // These are lemmas for induction, not claims. The flag says exactly whether
  // the current error was logged. No error from a later iteration was logged
  // yet.
  invariant FlagTracksCurrentError {
    loggedSinceDefinition == loggedErrors.contains(currentError)
  }
  invariant NothingLoggedAhead {
    forall errorNumber: ErrorNumber {
      loggedErrors.contains(errorNumber) => errorNumber <= currentError
    }
  }
}
