// This models a may-analysis: a helper counts as logging its argument when
// some path logs it. See must_log.fsl for the rule in use. The witness of
// SummarySaysLogsButHelperDidNot is the reason the rule is not this one.
//
// Some helpers log only some errors, such as one that skips the errors it
// expects. A may-analysis makes every caller that returns the error a report.
// That includes the calls where the helper logged nothing.
//
// The helper has one of these shapes:
//
//   Always      log(err)
//   IfNonNil    if err != nil { log(err) }, or: if err == nil { return }; log(err)
//   IfOther     if cond { log(err) }, for any condition but a nil check
//   Recursive   logs on the base case, and calls itself on the other path
//   Never       does not log err
//
// helperLogs is a hand copy of must_log.fsl's, without the Merged shape.
// Nothing checks that the copies agree.
fsl 5
spec MustLogMay {
  enum Shape { Always, IfNonNil, IfOther, Recursive, Never }

  state {
    helperRan: Bool,
    shape: Shape,
    errorIsNonNil: Bool,
    otherConditionHolds: Bool,
    helperLogged: Bool,
    summarySaysLogs: Bool
  }

  init {
    helperRan = false
    shape = Never
    errorIsNonNil = false
    otherConditionHolds = false
    helperLogged = false
    summarySaysLogs = false
  }

  // What one run of the helper logs.
  def helperLogs(helperShape: Shape, nonNil: Bool, conditionHolds: Bool) =
    helperShape == Always
    or helperShape == Recursive
    or (helperShape == IfNonNil and nonNil)
    or (helperShape == IfOther and conditionHolds)

  // What a may-analysis concludes: any path that logs is enough.
  def summaryCountsAsLogging(helperShape: Shape) = helperShape != Never

  action runHelper(helperShape: Shape, nonNil: Bool, conditionHolds: Bool) {
    requires not helperRan
    helperRan = true
    shape = helperShape
    errorIsNonNil = nonNil
    otherConditionHolds = conditionHolds
    helperLogged = helperLogs(helperShape, nonNil, conditionHolds)
    summarySaysLogs = summaryCountsAsLogging(helperShape)
  }

  terminal { helperRan }

  // The caller's report rests on must_log.fsl's ReportMeansLogged. This is its
  // negation. The witness shows that a may-analysis is wrong.
  reachable SummarySaysLogsButHelperDidNot {
    not (helperRan and summarySaysLogs and errorIsNonNil => helperLogged)
  }
}
