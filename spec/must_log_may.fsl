// FAILS ON PURPOSE. This models a may-analysis: a helper counts as logging
// its argument when some path logs it. See must_log.fsl for the rule in use.
//
// A helper that logs only some errors, such as one that skips errors it
// expects, would make every caller that returns the error a report, including
// the calls where the helper logged nothing.
//
// The helper's shape is one of:
//
//   Always      log(err)
//   IfNonNil    if err != nil { log(err) }, or: if err == nil { return }; log(err)
//   IfOther     if cond { log(err) }, for any condition but a nil check
//   Recursive   logs on the base case, and calls itself on the other path
//   Never       does not log err
//
spec MustLogMay {
  enum Shape { Always, IfNonNil, IfOther, Recursive, Never }

  state {
    ran: Bool, shape: Shape, nonNil: Bool, cond: Bool,
    logged: Bool, summaryLogs: Bool
  }

  init {
    ran = false  shape = Never  nonNil = false  cond = false
    logged = false  summaryLogs = false
  }

  // What running the helper once logs.
  def logs(s: Shape, nn: Bool, c: Bool) =
    s == Always or s == Recursive or (s == IfNonNil and nn) or (s == IfOther and c)

  // What a may-analysis concludes: any path that logs is enough.
  def summarized(s: Shape) = s != Never

  action run(s: Shape, nn: Bool, c: Bool) {
    requires not ran
    ran = true  shape = s  nonNil = nn  cond = c
    logged = logs(s, nn, c)
    summaryLogs = summarized(s)
  }

  terminal { ran }

  // The property the caller's report rests on.
  invariant ReportMeansLogged { ran and summaryLogs and nonNil => logged }
}
