// This is the rule that loop_exit.fsl replaced. The witness of
// ReportsAnUnloggedError is the reason for the change.
//
// The walk follows every edge after the log. That includes the exit of the
// loop condition, tested at the head or at the bottom of the body. In the
// retry loop of loop_exit.fsl, that exit cannot run after the log. The walk
// still reaches return err through it without a new definition of err. So a
// log on any retry is reported against the final return. That return hands
// back the last attempt's error, which was never logged.
//
//   for attempt := 1; attempt <= MAX_ATTEMPTS; attempt++ {
//     err = do()
//     if err == nil { return nil }
//     if attempt == MAX_ATTEMPTS { break }
//     log(err)
//   }
//   return err
//
// This model is not a copy of loop_exit.fsl's. It numbers the errors to give
// a ground truth. loop_exit.fsl tracks the guard instead.
//
// ASSUME-1: MAX_ATTEMPTS bounds the number of attempts. It is a modeling
// bound, not a claim about loops.
fsl 5
spec LoopExitNaive {
  const MAX_ATTEMPTS = 3
  type Attempt = 1..MAX_ATTEMPTS + 1
  type ErrorNumber = 0..MAX_ATTEMPTS
  enum Location { Head, Body, Returned }

  state {
    location: Location,
    attempt: Attempt,
    currentError: ErrorNumber,
    loggedErrors: Set<ErrorNumber>,
    reported: Bool,
    returnedWasLogged: Bool
  }

  init {
    location = Head
    attempt = 1
    currentError = 0
    loggedErrors = Set {}
    reported = false
    returnedWasLogged = false
  }

  action enterBody() {
    requires location == Head
    requires attempt <= MAX_ATTEMPTS
    requires currentError < MAX_ATTEMPTS
    location = Body
    currentError = currentError + 1
  }

  action succeed() {
    requires location == Body
    location = Returned
  }

  // Any earlier log reaches this return through the exit edge of the head.
  action giveUp() {
    requires location == Body
    requires attempt == MAX_ATTEMPTS
    location = Returned
    reported = loggedErrors.size() > 0
    returnedWasLogged = loggedErrors.contains(currentError)
  }

  action logThenRetry() {
    requires location == Body
    requires attempt < MAX_ATTEMPTS
    loggedErrors = loggedErrors.add(currentError)
    attempt = attempt + 1
    location = Head
  }

  terminal { location == Returned }

  // The negation of "never reports an unlogged error". The witness shows
  // that this rule is wrong.
  reachable ReportsAnUnloggedError { not (reported => returnedWasLogged) }
}
