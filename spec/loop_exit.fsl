// What the loop rule relies on.
//
// The path walk ignores branch conditions it cannot decide. After a log in a
// loop, it may take the loop's exit. It then reaches the return with the value
// it logged. That exit may be one the program never takes right after a log:
//
//   for attempt := 1; attempt <= MAX_ATTEMPTS; attempt++ {   exitLoop when this fails
//     err = do()                                             enterBody: a new error
//     if err == nil { return nil }                           succeed
//     if attempt == MAX_ATTEMPTS { break }                   the guard: giveUp
//     log(err)                                               logThenRetry
//   }
//   return err
//
// The rule reads the loop's tests of the counter. They give its value on the
// last iteration, MAX_ATTEMPTS here. The rule evaluates the guard that leads to
// the log at that value. When the guard fails there, the walk does not take
// the loop's exit. It still goes round the loop, where the next iteration
// defines a new error.
//
// The spec runs the program with any guard. guardPassesOn is the set of
// attempts on which the guard lets the log run. It is built before the loop
// starts. The rule's judgement is ruleIsSilent: MAX_ATTEMPTS is not in the
// set. exitedRightAfterLog records that the loop exited right after a log, with
// nothing redefined in between. That is the run the walk's report stands for.
//
// SilenceLosesNothing is the lemma: whenever the rule is silent, that run
// never happens. ReportedWhenLastLogs shows that the run exists when the guard
// lets the last attempt log. So the report the rule leaves standing is
// genuine.
//
// Staying silent never produces a false report. So the rule cannot reach
// the state of ReportsAnUnloggedError in loop_exit_naive.fsl. What needs
// proving is that the silence is right.
//
// ASSUME-1: MAX_ATTEMPTS bounds the number of attempts. It is a modeling
// bound, not a claim about loops.
// ASSUME-2: the rule evaluates the guard at the counter's last value
// correctly. The functions loop.counterOf, loop.LastOf and loop.at read only
// a counter that steps by 1 or -1 and is compared with one bound. A test or a
// guard they cannot read drops the exits. That only adds silence, so this
// spec does not need to justify it. A counter kept in memory, such as one a
// closure captures, is such a counter. A loop with one test and no guard on
// its counter keeps that exit. That is the walk without this rule. A guard
// against a constant, when the bound is handed in, holds on the last attempt
// for some bounds and not others. An example is i < 2 against n-1. The rule
// reads it for a large bound, past the constant. MAX_ATTEMPTS then stands
// for that bound, not for every bound. i < 2 is silent for a bound of 2,
// where the last attempt logs. That is a missed report, not a false one.
// i > 0 is reported for a bound of 1, where it never logs. One attempt is
// not a retry, and this spec does not cover that report. A loop with several
// tests keeps only the exit of the test that ends it first. That is the exit
// this spec's head stands for.
fsl 5
spec LoopExit {
  const MAX_ATTEMPTS = 3
  type Attempt = 1..MAX_ATTEMPTS + 1
  // GaveUp is the return through the guard on the last attempt. It is kept
  // apart from Returned so that a witness can name the give-up path.
  enum Location { Start, Head, Body, Returned, GaveUp }

  state {
    guardPassesOn: Set<Attempt>,
    location: Location,
    attempt: Attempt,
    justLogged: Bool,
    exitedRightAfterLog: Bool
  }

  init {
    guardPassesOn = Set {}
    location = Start
    attempt = 1
    justLogged = false
    exitedRightAfterLog = false
  }

  def guardPassesOnLastAttempt() = guardPassesOn.contains(MAX_ATTEMPTS)
  def ruleIsSilent() = not guardPassesOnLastAttempt()

  action letGuardPass(passingAttempt: Attempt) {
    requires location == Start
    requires passingAttempt <= MAX_ATTEMPTS
    guardPassesOn = guardPassesOn.add(passingAttempt)
  }

  action startLoop() {
    requires location == Start
    location = Head
  }

  action enterBody() {
    requires location == Head
    requires attempt <= MAX_ATTEMPTS
    location = Body
    justLogged = false
  }

  // The loop condition fails, and the function returns what err holds.
  action exitLoop() {
    requires location == Head
    requires attempt > MAX_ATTEMPTS
    location = Returned
    exitedRightAfterLog = justLogged
  }

  action succeed() {
    requires location == Body
    location = Returned
  }

  // The guard fails on the last attempt. That attempt breaks out and returns
  // its error without logging it.
  action giveUp() {
    requires location == Body
    requires attempt == MAX_ATTEMPTS
    requires not guardPassesOn.contains(attempt)
    location = GaveUp
  }

  action logThenRetry() {
    requires location == Body
    requires guardPassesOn.contains(attempt)
    justLogged = true
    attempt = attempt + 1
    location = Head
  }

  action skipLogThenRetry() {
    requires location == Body
    requires not guardPassesOn.contains(attempt)
    attempt = attempt + 1
    location = Head
  }

  terminal { location == Returned or location == GaveUp }

  invariant SilenceLosesNothing { ruleIsSilent() => not exitedRightAfterLog }

  reachable ReportedWhenLastLogs {
    guardPassesOnLastAttempt()
    and exitedRightAfterLog
  }
  reachable SilentRetriesThenGivesUp {
    ruleIsSilent()
    and guardPassesOn.size() > 0
    and location == GaveUp
  }

  // --- auxiliary ---
  // These are lemmas for induction, not claims. A guard that fails on the
  // last attempt may also fall through to the head, past MAX_ATTEMPTS, with
  // nothing logged. So the head past MAX_ATTEMPTS right after a log means the
  // guard passed on the last attempt. The reset in enterBody is what keeps a
  // log from an earlier attempt out of that.
  invariant PastMaxOnlyAfterLastLog {
    (location == Head and attempt > MAX_ATTEMPTS and justLogged)
    => guardPassesOnLastAttempt()
  }
  invariant BodyStartsUnlogged { location == Body => not justLogged }
  invariant BodyInRange { location == Body => attempt <= MAX_ATTEMPTS }
  invariant StartsFresh {
    location == Start
    => (attempt == 1
        and not justLogged
        and not exitedRightAfterLog)
  }
}
