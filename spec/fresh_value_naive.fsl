// This is the rule that fresh_value.fsl replaced. The witness of
// ReportsAFreshValue is the reason for the change.
//
// The rule compares SSA values and nothing else. A call in a loop body is one
// SSA value in every iteration. So an error logged in one iteration matches a
// new error returned in the next. woodpecker's cli/pipeline/purge.go was
// reported for exactly this before the rule changed.
//
// The program is the loop of fresh_value.fsl:
//
//   for {
//     err := do()
//     log(err)
//     return err
//   }
//
// The program and the ground truth are hand copies of fresh_value.fsl's.
// Nothing checks that they agree.
//
// ASSUME-1: MAX_ITERATIONS bounds the number of iterations. It is a modeling
// bound, not a claim about loops.
fsl 5
spec FreshValueNaive {
  const MAX_ITERATIONS = 3
  type ErrorNumber = 0..MAX_ITERATIONS
  enum Location { Define, Body, Returned }

  state {
    location: Location,
    currentError: ErrorNumber,
    loggedErrors: Set<ErrorNumber>,
    reported: Bool,
    returnedWasLogged: Bool
  }

  init {
    location = Define
    currentError = 0
    loggedErrors = Set {}
    reported = false
    returnedWasLogged = false
  }

  action defineError() {
    requires location == Define
    requires currentError < MAX_ITERATIONS
    location = Body
    currentError = currentError + 1
  }

  action logError() {
    requires location == Body
    loggedErrors = loggedErrors.add(currentError)
  }

  action loopBack() {
    requires location == Body
    location = Define
  }

  // Any earlier log of the same SSA value counts.
  action returnError() {
    requires location == Body
    location = Returned
    reported = loggedErrors.size() > 0
    returnedWasLogged = loggedErrors.contains(currentError)
  }

  terminal {
    location == Returned
    or (location == Define and currentError == MAX_ITERATIONS)
  }

  // The negation of fresh_value.fsl's NeverReportsAFreshValue. The witness
  // shows that this rule is wrong.
  reachable ReportsAFreshValue { not (reported => returnedWasLogged) }
}
