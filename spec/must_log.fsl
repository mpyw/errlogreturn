// A helper counts as logging its argument only when every path that returns
// logs it. A path on which the argument is known to be nil counts as logging
// it. A nil error has nothing to log.
//
// A caller that passes an error to such a helper and then returns it is
// reported. The report is only right if the helper really logged that error.
// So this spec checks one property. Whenever the summary says "logs" and the
// error is a real one, the helper logged it.
//
// The helper has one of these shapes:
//
//   Always      log(err)
//   IfNonNil    if err != nil { log(err) }, or: if err == nil { return }; log(err)
//   IfOther     if cond { log(err) }, for any condition but a nil check
//   Recursive   logs on the base case, and calls itself on the other path
//   Never       does not log err
//
// A recursive call reads the summary that is still being built. That summary
// says nothing yet. So the summary does not count Recursive, though it logs.
// MissedWhenRecursive witnesses the report given up for that.
fsl 5
spec MustLog {
  enum Shape { Always, IfNonNil, IfOther, Recursive, Never }

  state {
    helperRan: Bool,
    shape: Shape,
    errorIsNonNil: Bool,
    otherConditionHolds: Bool,
    helperLogged: Bool,
    summarySaysLogs: Bool
  }

  init {
    helperRan = false
    shape = Never
    errorIsNonNil = false
    otherConditionHolds = false
    helperLogged = false
    summarySaysLogs = false
  }

  // What one run of the helper logs.
  def helperLogs(helperShape: Shape, nonNil: Bool, conditionHolds: Bool) =
    helperShape == Always
    or helperShape == Recursive
    or (helperShape == IfNonNil and nonNil)
    or (helperShape == IfOther and conditionHolds)

  // What the must-analysis concludes from the helper's body.
  def summaryCountsAsLogging(helperShape: Shape) =
    helperShape == Always
    or helperShape == IfNonNil

  action runHelper(helperShape: Shape, nonNil: Bool, conditionHolds: Bool) {
    requires not helperRan
    helperRan = true
    shape = helperShape
    errorIsNonNil = nonNil
    otherConditionHolds = conditionHolds
    helperLogged = helperLogs(helperShape, nonNil, conditionHolds)
    summarySaysLogs = summaryCountsAsLogging(helperShape)
  }

  terminal { helperRan }

  // The caller's report rests on this property.
  invariant ReportMeansLogged {
    helperRan and summarySaysLogs and errorIsNonNil => helperLogged
  }

  reachable CountsANilCheck {
    helperRan
    and shape == IfNonNil
    and summarySaysLogs
  }
  reachable IgnoresOtherConditions {
    helperRan
    and shape == IfOther
    and otherConditionHolds
    and helperLogged
    and not summarySaysLogs
  }
  reachable MissedWhenRecursive {
    helperRan
    and shape == Recursive
    and helperLogged
    and not summarySaysLogs
  }
}
