// FAILS ON PURPOSE. This is the rule that phi_identity.fsl replaced. The
// counterexample is the reason for the change.
//
// The rule expands every φ-node it has not resolved to all of its edges. A log
// of the φ-node then counts as a log of shared, whichever edge ran. So
// returning shared is reported even when the new error was the one logged.
// In usememos/memos, store/attachment.go logged a φ-node of a shared error and
// a new one inside a loop. It was reported for this shape.
//
// The program and the analysis are those of phi_identity.fsl. Only the last
// row of ruleReports differs. They are hand copies, and nothing checks that
// they agree.
//
// The program merges two errors. It may log either one before it returns:
//
//   err := shared          merge(Shared): an error defined before the merge
//   if cond {
//     err = do()           merge(Fresh): a new error
//   }
//   log(err)               logPhi: logs whichever edge ran
//   return shared          or: return err
//
// shared dominates everything, so it can be logged or returned anywhere. The
// new error is reachable only through the φ-node.
//
// The analysis starts its path walk at the log call. A merge the walk enters
// after the log is resolved to the edge it came in on. A merge before the log
// is not resolved. This rule expands it to all of its edges instead.
fsl 5
spec PhiExpand {
  enum Edge { Shared, Fresh }
  enum ReturnedValue { ReturnsShared, ReturnsPhi }

  state {
    mergeEdge: Option<Edge>,
    loggedShared: Bool,
    sharedLoggedBeforeMerge: Bool,
    loggedPhi: Bool,
    returned: Option<ReturnedValue>,
    reported: Bool,
    returnedWasLogged: Bool
  }

  init {
    mergeEdge = none
    loggedShared = false
    sharedLoggedBeforeMerge = false
    loggedPhi = false
    returned = none
    reported = false
    returnedWasLogged = false
  }

  action logShared() {
    requires returned == none
    loggedShared = true
    if mergeEdge == none {
      sharedLoggedBeforeMerge = true
    }
  }

  action merge(edge: Edge) {
    requires mergeEdge == none
    requires returned == none
    mergeEdge = some(edge)
  }

  action logPhi() {
    requires mergeEdge != none
    requires returned == none
    loggedPhi = true
  }

  // Which error the φ-node holds at run time.
  def phiIsShared() = mergeEdge == some(Shared)

  // The ground truth: the returned error is one that was logged.
  def returnsALoggedError(value: ReturnedValue) =
    if value == ReturnsShared then
      loggedShared or (loggedPhi and phiIsShared())
    else
      (loggedShared and phiIsShared()) or loggedPhi

  // What the analysis reports. It pairs each log with the return.
  //
  //   log shared,  return shared   the same value
  //   log shared,  return φ        only when the walk from the log entered the
  //                                merge, and the edge it took was shared
  //   log φ,       return φ        the same φ-node, by identity
  //   log φ,       return shared   always: shared is one of the φ-node's edges
  // edgeIsShared says the merge took the Shared edge. The rule may read it only
  // through a walk that entered the merge.
  def ruleReports(value: ReturnedValue, edgeIsShared: Bool) =
    if value == ReturnsShared then
      loggedShared or loggedPhi
    else
      (loggedShared and sharedLoggedBeforeMerge and edgeIsShared)
      or loggedPhi

  action returnError(value: ReturnedValue) {
    requires mergeEdge != none
    requires returned == none
    returned = some(value)
    reported = ruleReports(value, phiIsShared())
    returnedWasLogged = returnsALoggedError(value)
  }

  terminal { returned != none }

  invariant NeverReportsAnUnloggedError { reported => returnedWasLogged }
}
